# ─── Required env vars ─────────────────────────────────────────────────────────
# Add these in Vercel → Project Settings → Environment Variables

# Resend — get from resend.com/api-keys
# To send FROM a custom address (e.g. noreply@kshetejsareen.com), verify the
# domain in Resend: Settings → Domains → Add Domain → add DNS records.
# Until then, use onboarding@resend.dev (only delivers to your Resend account email).
RESEND_API_KEY=re_...

# The "from" address. Must be on a Resend-verified domain.
FROM_EMAIL=noreply@kshetejsareen.com
