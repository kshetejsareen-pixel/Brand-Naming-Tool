# ─── Required env vars ─────────────────────────────────────────────────────────
# Add these in Vercel → Project Settings → Environment Variables

# Resend — get from resend.com/api-keys
# To send FROM a custom address (e.g. noreply@kshetejsareen.com), verify the
# domain in Resend: Settings → Domains → Add Domain → add DNS records.
# Until then, use onboarding@resend.dev (only delivers to your Resend account email).
RESEND_API_KEY=re_...

# The "from" address. Must be on a Resend-verified domain.
FROM_EMAIL=noreply@kshetejsareen.com

# Anthropic — get from console.anthropic.com/settings/keys
# Used to generate the 7 naming directions server-side at submit time.
# If unset, submissions still work — the studio falls back to manually
# pasting the Claude-ready brief (in the email) into a Claude conversation.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel Blob — auto-populated by Vercel when a Blob store is attached to the
# project. Only needs to be set manually for local development.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Shared password for /admin. Pick a long random string.
ADMIN_KEY=
